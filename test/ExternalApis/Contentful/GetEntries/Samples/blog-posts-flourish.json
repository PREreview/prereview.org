                },
                "content": []
              },
              {
                "nodeType": "heading-3",
                "data": {},
                "content": [{ "nodeType": "text", "value": "Stay connected", "marks": [], "data": {} }]
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  { "nodeType": "text", "value": "You can follow us on ", "marks": [], "data": {} },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://mas.to/@prereview" },
                    "content": [{ "nodeType": "text", "value": "Mastodon", "marks": [], "data": {} }]
                  },
                  { "nodeType": "text", "value": ", ", "marks": [], "data": {} },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://bsky.app/profile/prereview.bsky.social" },
                    "content": [{ "nodeType": "text", "value": "BlueSky", "marks": [], "data": {} }]
                  },
                  { "nodeType": "text", "value": ", ", "marks": [], "data": {} },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://www.linkedin.com/company/prereview" },
                    "content": [{ "nodeType": "text", "value": "LinkedIn", "marks": [], "data": {} }]
                  },
                  { "nodeType": "text", "value": ", and ", "marks": [], "data": {} },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://youtube.com/@prereview7336?si=XJkOWtTou9V5Zg2k" },
                    "content": [{ "nodeType": "text", "value": "YouTube", "marks": [], "data": {} }]
                  },
                  {
                    "nodeType": "text",
                    "value": " to see the incredible things our Champions are up to. Keep up with all the latest news at PREreview by ",
                    "marks": [],
                    "data": {}
                  },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://bit.ly/PREreview-newsletter" },
                    "content": [
                      { "nodeType": "text", "value": "subscribing to our newsletter", "marks": [], "data": {} }
                    ]
                  },
                  { "nodeType": "text", "value": " and ", "marks": [], "data": {} },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://bit.ly/PREreview-Slack" },
