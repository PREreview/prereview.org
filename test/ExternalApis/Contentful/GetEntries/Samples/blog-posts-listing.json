  "items": [
    {
      "fields": {
        "title": { "en-US": "An interview with PREreview Champion Shitondo Yahila" },
        "slug": { "en-US": "interview-prereview-champion-shitondo-yahila" },
        "heroImage": { "en-US": { "sys": { "type": "Link", "linkType": "Entry", "id": "tEl2h67YNhYHMLBSGhuKX" } } },
        "excerpt": {
          "en-US": "In this feature, Shitondo stresses out the importance of concentrating Open Science advocacy efforts in low-resource settings and educational institutions for a broader adoption of its principles and practices."
        }
      },
      "sys": {
        "space": { "sys": { "type": "Link", "linkType": "Space", "id": "66hjlpng9xzg" } },
        "id": "6FNOWXGcgE5kCGR9a48be0",
        "type": "Entry",
        "createdAt": "2026-10-01T10:00:19.886Z",
        "updatedAt": "2026-10-01T10:00:19.886Z",
        "environment": { "sys": { "id": "master", "type": "Link", "linkType": "Environment" } },
        "publishedVersion": 1,
        "revision": 1,
        "contentType": { "sys": { "type": "Link", "linkType": "ContentType", "id": "blogPost" } }
      }
    },
    {
      "fields": {
        "title": { "en-US": "PREreview platform news, 4 September 2026" },
        "slug": { "en-US": "prereview-platform-news-4-september-2026" },
        "heroImage": { "en-US": { "sys": { "type": "Link", "linkType": "Entry", "id": "28AIZ2id3xhfUgayU1mLAI" } } },
        "excerpt": {
          "en-US": "We’re testing out an algorithm to suggest preprints for review based on your ORCID public profile. Take part in our second matchmaking experiment and help us with your valuable feedback!"
        }
      },
      "sys": {
        "space": { "sys": { "type": "Link", "linkType": "Space", "id": "66hjlpng9xzg" } },
        "id": "21aDv21LIehQdwkQM2Ew5v",
        "type": "Entry",
        "createdAt": "2026-10-01T10:00:19.184Z",
        "updatedAt": "2026-10-01T10:00:19.184Z",
        "environment": { "sys": { "id": "master", "type": "Link", "linkType": "Environment" } },
        "publishedVersion": 1,
        "revision": 1,
        "contentType": { "sys": { "type": "Link", "linkType": "ContentType", "id": "blogPost" } }
      }
    },
    {
      "fields": {
        "title": { "en-US": "PREreview platform news, 28 August 2026" },
        "slug": { "en-US": "prereview-platform-news-28-august-2026" },
        "heroImage": { "en-US": { "sys": { "type": "Link", "linkType": "Entry", "id": "37xDpSlpjUSqN3PqE5EkP0" } } },
        "excerpt": {
          "en-US": "This week we’ve reached another multilingual milestone by adding African French to the site. We also sent out invitations to PREreview Champions and Club leads to give us feedback on our second matchmaking experiment. "
        }
      },
      "sys": {
        "space": { "sys": { "type": "Link", "linkType": "Space", "id": "66hjlpng9xzg" } },
        "id": "1ceRkEgcCHfP1p2o68lbG9",
        "type": "Entry",
        "createdAt": "2026-10-01T10:00:18.463Z",
        "updatedAt": "2026-10-01T10:00:18.463Z",
        "environment": { "sys": { "id": "master", "type": "Link", "linkType": "Environment" } },
        "publishedVersion": 1,
        "revision": 1,
        "contentType": { "sys": { "type": "Link", "linkType": "ContentType", "id": "blogPost" } }
      }
    },
    {
      "fields": {
        "title": { "en-US": "An interview with PREreview Champion Mabel Omoniwa" },
        "slug": { "en-US": "interview-prereview-champion-mabel-omoniwa" },
        "heroImage": { "en-US": { "sys": { "type": "Link", "linkType": "Entry", "id": "70ziHUUOQbuqXF0XhL7N1J" } } },
        "excerpt": {
          "en-US": "In this piece, Mabel weighs on the opportunities Open Peer Review presents to early-career researchers and scholars from resource-constrained settings, while considering the conditions needed to foster its adoption."
        }
      },
      "sys": {
        "space": { "sys": { "type": "Link", "linkType": "Space", "id": "66hjlpng9xzg" } },
        "id": "4EYzoj6QjyUY1p7ME96xXJ",
        "type": "Entry",
        "createdAt": "2026-10-01T10:00:17.691Z",
        "updatedAt": "2026-10-01T10:00:17.691Z",
        "environment": { "sys": { "id": "master", "type": "Link", "linkType": "Environment" } },
        "publishedVersion": 1,
        "revision": 1,
        "contentType": { "sys": { "type": "Link", "linkType": "ContentType", "id": "blogPost" } }
      }
    },
    {
      "fields": {
        "title": { "en-US": "PREreview August 2026 Newsletter" },
        "slug": { "en-US": "august-newsletter" },
        "heroImage": { "en-US": { "sys": { "type": "Link", "linkType": "Entry", "id": "75J3eUFgFfWqfwV1aZSKDK" } } },
        "excerpt": {
          "en-US": "In the past couple of months, PREreview’s team and community members have been actively championing open research evaluation, while cultivating new relationships around the globe. Dive in, and help us ripple further."
        }
      },
      "sys": {
        "space": { "sys": { "type": "Link", "linkType": "Space", "id": "66hjlpng9xzg" } },
