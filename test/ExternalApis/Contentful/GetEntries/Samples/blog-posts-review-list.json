        "channel": { "en-US": "weeknote" },
        "excerpt": { "en-US": "Welcome back to our weekly update on all things PREreview.org!" },
        "content": {
          "en-US": {
            "nodeType": "document",
            "data": {},
            "content": [
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "Welcome back to our weekly update on all things PREreview.org!",
                    "marks": [],
                    "data": {}
                  }
                ]
              },
              {
                "nodeType": "heading-1",
                "data": {},
                "content": [{ "nodeType": "text", "value": "What’s new at PREreview?", "marks": [], "data": {} }]
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "As we continue developing our Structured PREreview workflow (which will take the place of our old Rapid PREReview workflow), we’re excited for all the new PREreviews being published by ",
                    "marks": [],
                    "data": {}
                  },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://asapbio.org/crowd-review-2023" },
                    "content": [{ "nodeType": "text", "value": "ASAPbio Crowds", "marks": [], "data": {} }]
                  },
                  {
                    "nodeType": "text",
                    "value": " and their PREreview Clubs! Check them out!",
                    "marks": [],
                    "data": {}
                  }
                ]
              },
              {
                "nodeType": "embedded-entry-block",
                "data": { "target": { "sys": { "id": "neCcTtYkdVfEyOqMX7eOo", "type": "Link", "linkType": "Entry" } } },
                "content": []
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "Keep up with our blog for more news on Clubs - and how to start your own - very soon!",
                    "marks": [],
                    "data": {}
                  }
                ]
              },
              {
                "nodeType": "heading-1",
                "data": {},
                "content": [{ "nodeType": "text", "value": "What’s next?", "marks": [], "data": {} }]
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "Up next, we’ll be working on testing and releasing our Structured PREreview workflow, as well as updated profile pages, and new request-a-review integrations powered by the ",
                    "marks": [],
                    "data": {}
                  },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://notify.coar-repositories.org/" },
                    "content": [{ "nodeType": "text", "value": "COAR Notify Protocol", "marks": [], "data": {} }]
                  },
                  { "nodeType": "text", "value": ".", "marks": [], "data": {} }
                ]
              },
              {
                "nodeType": "heading-1",
                "data": {},
                "content": [{ "nodeType": "text", "value": "Let us know what you think", "marks": [], "data": {} }]
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "Share your PREreview experiences with PREreview.org anytime by scheduling a user research interview with Product Manager Chad Sansing. You can ",
                    "marks": [],
                    "data": {}
                  },
                  {
                    "nodeType": "hyperlink",
                    "data": {
                      "uri": "https://calendar.google.com/calendar/u/0/selfsched?sstoken=UUw4R0F6MVo1ZWhyfGRlZmF1bHR8ZGM2YTU1OTNhYzNhY2RiN2YzNTBlYTdmZTBmMzNmNDA"
                    },
                    "content": [
                      { "nodeType": "text", "value": "click here to sign up for a chat", "marks": [], "data": {} }
                    ]
                  },
                  {
                    "nodeType": "text",
                    "value": ". If you can’t find a time that works for you, please ",
                    "marks": [],
                    "data": {}
                  },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "mailto:chad@prereview.org" },
                    "content": [{ "nodeType": "text", "value": "email Chad", "marks": [], "data": {} }]
                  },
                  {
                    "nodeType": "text",
                    "value": " to arrange a call. Whenever possible, we compensate interviewees.",
                    "marks": [],
                    "data": {}
                  }
                ]
              },
              {
                "nodeType": "embedded-entry-block",
                "data": {
                  "target": { "sys": { "id": "7aPEGdSXg0JsJIqOJu8n94", "type": "Link", "linkType": "Entry" } }
                },
                "content": []
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  { "nodeType": "text", "value": "You can join our ", "marks": [], "data": {} },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://bit.ly/PREreview-Slack" },
                    "content": [{ "nodeType": "text", "value": "community Slack", "marks": [], "data": {} }]
                  },
                  {
                    "nodeType": "text",
                    "value": " and share your PREreview stories on the #community-feedback channel, as well.",
                    "marks": [],
                    "data": {}
                  }
                ]
              },
              {
                "nodeType": "embedded-entry-block",
                "data": {
                  "target": { "sys": { "id": "1MuRXkDcRt86unxnpNsTb4", "type": "Link", "linkType": "Entry" } }
                },
                "content": []
              },
              {
                "nodeType": "heading-1",
                "data": {},
                "content": [{ "nodeType": "text", "value": "Stay connected", "marks": [], "data": {} }]
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "Join us again next Friday for more news from PREreview.org.",
                    "marks": [],
                    "data": {}
                  }
                ]
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  { "nodeType": "text", "value": "Until then, you can find us on ", "marks": [], "data": {} },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://mas.to/@prereview" },
                    "content": [{ "nodeType": "text", "value": "Mastodon", "marks": [], "data": {} }]
                  },
                  { "nodeType": "text", "value": ",", "marks": [], "data": {} },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://twitter.com/PREreview_" },
                    "content": [{ "nodeType": "text", "value": " Twitter", "marks": [], "data": {} }]
                  },
                  { "nodeType": "text", "value": ", and", "marks": [], "data": {} },
                  {
                    "nodeType": "hyperlink",
                    "data": {
                      "uri": "https://www.linkedin.com/company/prereview?original_referer=https%3A%2F%2Fwww.google.com%2F"
                    },
                    "content": [{ "nodeType": "text", "value": " LinkedIn", "marks": [], "data": {} }]
                  },
                  { "nodeType": "text", "value": ". Please also take a moment to", "marks": [], "data": {} },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://prereview.civicrm.org/civicrm/profile/create?gid=14&reset=1" },
