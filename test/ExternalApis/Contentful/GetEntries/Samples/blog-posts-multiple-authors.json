                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "Thanks for checking out the latest update from the product team at ",
                    "marks": [],
                    "data": {}
                  },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://prereview.org" },
