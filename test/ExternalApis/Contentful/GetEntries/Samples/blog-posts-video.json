  "items": [
    {
      "metadata": { "tags": [], "concepts": [] },
      "sys": {
        "space": { "sys": { "type": "Link", "linkType": "Space", "id": "dapbmjoaf8gb" } },
        "id": "1s9xLYSv0uJ2QcEJlxTgYV",
        "type": "Entry",
        "createdAt": "2026-10-08T13:10:56.560Z",
        "updatedAt": "2026-10-09T09:39:19.969Z",
        "environment": { "sys": { "id": "master", "type": "Link", "linkType": "Environment" } },
        "publishedVersion": 4,
        "revision": 2,
        "contentType": { "sys": { "type": "Link", "linkType": "ContentType", "id": "blogPost" } }
      },
      "fields": {
        "title": { "en-US": "Call to Help Rapidly Review COVID-19 Preprints" },
        "slug": { "en-US": "help-rapidly-review-covid-19-preprints" },
        "authors": { "en-US": [{ "sys": { "type": "Link", "linkType": "Entry", "id": "39RllAUZAZkxYszVuMP3ZC" } }] },
        "channel": { "en-US": "blog" },
        "content": {
          "en-US": {
            "nodeType": "document",
            "data": {},
            "content": [
              {
                "nodeType": "embedded-entry-block",
                "data": { "target": { "sys": { "id": "qI5G1avxGnPbrnB44kJnq", "type": "Link", "linkType": "Entry" } } },
                "content": []
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "The COVID-19 pandemic is pushing the boundaries of research evaluation and dissemination towards more collaborative and open workflows that include sharing research as preprints and engaging the research community in the review of these early versions of research manuscripts. ",
                    "marks": [],
                    "data": {}
                  }
                ]
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "On April 2020, PREreview joined a group of publishers and scholarly communications organizations in ",
                    "marks": [],
                    "data": {}
                  },
                  {
                    "nodeType": "hyperlink",
                    "data": {
                      "uri": "https://oaspa.org/scholarly-publishers-working-together-during-covid-19-pandemic/"
                    },
                    "content": [
                      { "nodeType": "text", "value": "announcing a joint initiative", "marks": [], "data": {} }
                    ]
                  },
                  {
                    "nodeType": "text",
                    "value": " that makes a direct call to the community—publishers, editors, reviewers,  and authors—to work together to maximize the efficiency of peer review of COVID-19 research from preprints to journal submission and beyond. ",
                    "marks": [],
                    "data": {}
                  }
                ]
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "The focus so far has been the review of research already submitted to journals. To speed up the process even further, ",
                    "marks": [],
                    "data": {}
                  },
                  {
                    "nodeType": "text",
                    "value": "WE NEED YOUR HELP to also triage preprints",
                    "marks": [{ "type": "bold" }],
                    "data": {}
                  },
                  {
                    "nodeType": "text",
                    "value": ". Help us prioritize the most important work so that it can be more rapidly advanced through peer review, flagging any issues or concerns with the research as soon as possible. ",
                    "marks": [],
                    "data": {}
                  }
                ]
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  { "nodeType": "text", "value": "Sign up ", "marks": [{ "type": "bold" }], "data": {} },
                  {
                    "nodeType": "hyperlink",
                    "data": {
                      "uri": "https://docs.google.com/forms/d/e/1FAIpQLSf7MILluJtO9xV2QXznWVd66UQU4puow4wSk7iwLz7iYcykfA/viewform"
                    },
                    "content": [{ "nodeType": "text", "value": "here", "marks": [{ "type": "bold" }], "data": {} }]
                  },
                  {
                    "nodeType": "text",
                    "value": " to be added to the rapid review list and received more information on how to help.",
                    "marks": [{ "type": "bold" }],
                    "data": {}
                  }
                ]
              },
              {
                "nodeType": "blockquote",
                "data": {},
                "content": [
                  {
                    "nodeType": "paragraph",
                    "data": {},
                    "content": [
                      {
                        "nodeType": "text",
                        "value": "As part of this initiative, our goal at PREreview is to manage the engagement and recruitment of the volunteer rapid reviewers to review COVID-19 preprints on Outbreak Science Rapid PREreview (OSrPRE), connect them to journal editors, and ultimately expedite COVID-19 research publication.",
                        "marks": [{ "type": "italic" }],
                        "data": {}
                      }
                    ]
                  }
                ]
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "This week we emailed the 1700+ researchers who have already volunteered to help, inviting them to rapidly review preprints on the free and open platform ",
                    "marks": [],
                    "data": {}
                  },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "https://outbreaksci.prereview.org" },
                    "content": [
                      {
                        "nodeType": "text",
                        "value": "Outbreak Science Rapid PREreview",
                        "marks": [{ "type": "bold" }],
                        "data": {}
                      }
                    ]
                  },
                  {
                    "nodeType": "text",
                    "value": ". There, any researcher with an ORCID iD can rapidly review outbreak-related preprints as well as request reviews from other community members. ",
                    "marks": [],
                    "data": {}
                  }
                ]
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "Below is a How-To Video on how to engage on Outbreak Science Rapid PREreview.",
                    "marks": [],
                    "data": {}
                  }
                ]
              },
              {
                "nodeType": "embedded-entry-block",
                "data": {
                  "target": { "sys": { "id": "3opCTl3Hvmf951bqriiCGC", "type": "Link", "linkType": "Entry" } }
                },
                "content": []
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "For general questions or concerns related to the use of the platform, please email us at ",
                    "marks": [],
                    "data": {}
                  },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "mailto:outbreaksci@prereview.org" },
                    "content": [{ "nodeType": "text", "value": "outbreaksci@prereview.org", "marks": [], "data": {} }]
                  },
                  { "nodeType": "text", "value": ".", "marks": [], "data": {} }
                ]
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "For questions or concerns relative to our role in this initiative, please email ",
                    "marks": [],
                    "data": {}
                  },
                  {
                    "nodeType": "hyperlink",
                    "data": { "uri": "mailto:c19rapidreview@prereview.org" },
                    "content": [
                      { "nodeType": "text", "value": "c19rapidreview@prereview.org", "marks": [], "data": {} }
                    ]
                  },
                  { "nodeType": "text", "value": ".", "marks": [], "data": {} }
                ]
              }
            ]
          }
        },
        "firstPublishedAtOverride": { "en-US": "2020-09-22T21:08:05.000+00:00" },
        "publishedAtOverride": { "en-US": "2023-06-05T13:35:00.000+00:00" }
      }
    }
  ],
